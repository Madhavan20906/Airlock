# Firebase web app configuration for Tandem (public identifiers, not secrets).
# Copy to .env.local and fill in from Firebase console > Project settings > Your apps.
VITE_FIREBASE_API_KEY=your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# App Check (required by Firebase AI Logic): reCAPTCHA v3 site key (public).
VITE_RECAPTCHA_SITE_KEY=your-recaptcha-v3-site-key

# Dev only, never commit: a registered App Check debug token. In `vite dev` the SDK prints one to the console.
# VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=
