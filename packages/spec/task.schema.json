{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TandemBenchTask",
  "description": "Synthetic labelled task generated by packages/tandem-bench/src/tasks.ts. split is fixed by FNV-1a(id) mod 2, never chosen by hand.",
  "type": "object",
  "required": ["id", "type", "lengthBucket", "sensitive", "split", "instruction", "input", "validators"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z_]+-[SML]-[0-9]{2}$" },
    "type": { "enum": ["classify", "extract", "rewrite", "summarize", "translate", "qa", "json_reliability", "instruction"] },
    "lengthBucket": { "enum": ["S", "M", "L"] },
    "sensitive": { "type": "boolean" },
    "split": { "enum": ["calibration", "heldout"] },
    "instruction": { "type": "string" },
    "input": { "type": "string" },
    "validators": {
      "type": "array",
      "items": { "type": "object", "required": ["kind"], "properties": { "kind": { "enum": ["exact", "contains", "json_schema", "field_f1", "required_facts", "max_len", "min_len", "script_present", "bullets", "no_refusal"] } } }
    }
  }
}
