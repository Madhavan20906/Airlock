{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TandemPolicy (Remote Config parameter tandem_policy_v1)",
  "description": "Compiled routing policy. Enforced at runtime by validatePolicy() in packages/tandem-policy (24 rules: 8 task types x 3 lengths). Invalid input falls back to the built-in conservative default. Decision rule: docs/POLICY_RULE.md.",
  "type": "object",
  "required": ["version", "generatedAt", "source", "device", "privacy", "params", "rules", "killSwitch", "budgets"],
  "properties": {
    "version": { "type": "integer", "minimum": 0 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "source": { "enum": ["studio", "default"] },
    "device": { "type": "object", "properties": { "class": { "type": "string" }, "notes": { "type": "string" } } },
    "privacy": {
      "type": "object",
      "required": ["sensitivityThreshold", "sensitiveRoute"],
      "properties": {
        "sensitivityThreshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "sensitiveRoute": { "enum": ["LOCAL_ONLY", "REDACT_THEN_CLOUD", "BLOCK"] }
      }
    },
    "params": {
      "type": "object",
      "required": ["qualityFloor", "tolerance", "latencyBudgetMs", "minN", "z"],
      "properties": {
        "qualityFloor": { "type": "number" }, "tolerance": { "type": "number" }, "latencyBudgetMs": { "type": "number" },
        "minN": { "type": "integer" }, "z": { "type": "number" }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 24,
      "maxItems": 24,
      "items": {
        "type": "object",
        "required": ["taskType", "lengthBucket", "route", "escalateOn", "timeoutMs", "evidence"],
        "properties": {
          "taskType": { "enum": ["classify", "extract", "rewrite", "summarize", "translate", "qa", "json_reliability", "instruction"] },
          "lengthBucket": { "enum": ["S", "M", "L"] },
          "route": { "enum": ["LOCAL_FIRST", "CLOUD_FIRST", "LOCAL_ONLY", "CLOUD_ONLY"] },
          "escalateOn": { "type": "array", "items": { "enum": ["schema", "length", "required_facts", "refusal", "timeout"] } },
          "timeoutMs": { "type": "number", "exclusiveMinimum": 0 },
          "evidence": {
            "type": "object",
            "required": ["status", "n", "why"],
            "properties": {
              "status": { "enum": ["measured", "pooled_by_type", "insufficient_evidence"] },
              "n": { "type": "integer" }, "nCloud": { "type": "integer" },
              "passLocal": { "type": ["number", "null"] }, "passCloud": { "type": ["number", "null"] },
              "wilsonLoLocal": { "type": ["number", "null"] }, "wilsonHiLocal": { "type": ["number", "null"] },
              "p50Local": { "type": ["number", "null"] }, "p95Local": { "type": ["number", "null"] },
              "p50Cloud": { "type": ["number", "null"] }, "p95Cloud": { "type": ["number", "null"] },
              "estCloudTokensAvoidedPer1k": { "type": "number" },
              "why": { "type": "string" }
            }
          }
        }
      }
    },
    "killSwitch": { "type": "object", "required": ["cloud", "local"], "properties": { "cloud": { "type": "boolean" }, "local": { "type": "boolean" } } },
    "budgets": { "type": "object", "required": ["maxCloudCallsPerMin"], "properties": { "maxCloudCallsPerMin": { "type": "integer", "minimum": 0 } } }
  }
}
