      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "node --test test/*.test.ts"
  },
  "keywords": [
    "privacy",
    "redaction",
    "pii",
    "india",
    "hybrid-ai"
  ],
  "author": "Tandem",
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^5.8.0"
  }
