{
  "name": "@tandem/guard",
  "version": "0.1.0",
  "type": "module",
  "description": "Tandem Guard: on-device detection, redaction, leak verification and rehydration of sensitive identifiers (Aadhaar, PAN, IFSC, UPI, GSTIN and more), plus the Guard Lab adversarial corpus",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
