rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Validates that ledger writes strictly contain audit metadata only
    // Rejects any attempt to store prompts, raw content, or oversize text
    function isValidLedgerEntry() {
      let data = request.resource.data;
      let allowedKeys = [
        'id', 'timestamp', 'route', 'reason', 'classifierMode',
        'sensitivityScore', 'entityCounts', 'complexity', 'latencyMs',
        'servedBy', 'placeholdersRestored', 'userConsentRequired'
      ];
      return data.keys().hasOnly(allowedKeys)
        && !('prompt' in data)
        && !('content' in data)
        && !('text' in data)
        && !('rawText' in data)
        && data.id is string
        && data.timestamp is number
        && data.route is string
        && data.reason is string
        && data.reason.size() <= 500
        && data.sensitivityScore is number
        && data.latencyMs is number
        && data.servedBy in ['on-device', 'cloud', 'blocked'];
    }

    // Helper: Validates user preference documents
    function isValidPreferenceEntry() {
      let data = request.resource.data;
      let allowedKeys = ['mode', 'killSwitchLocalOnly', 'enabledDetectors', 'updatedAt'];
      return data.keys().hasOnly(allowedKeys);
    }

    // User audit ledgers: isolated per-user, metadata-only
    match /users/{userId}/ledger/{eventId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null 
        && request.auth.uid == userId 
        && isValidLedgerEntry();
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // User preferences: isolated per-user
    match /users/{userId}/preferences/{docId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null 
        && request.auth.uid == userId 
        && isValidPreferenceEntry();
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // ------------------------------------------------------------------ Tandem
    function isOwner(userId) { return request.auth != null && request.auth.uid == userId; }

    // Router receipts: metadata only (no prompt/output/content fields can exist), create-only.
    function isValidReceipt() {
      let d = request.resource.data;
      return d.keys().hasOnly(['id', 'ts', 'taskType', 'lengthBucket', 'policyVersion', 'ruleRoute', 'guard', 'route',
          'servedBy', 'availabilityFallback', 'availabilityReason', 'qualityEscalation', 'validation', 'payloadBytes',
          'bytesOut', 'destination', 'latencyMs', 'why', 'prevHash', 'hash'])
        && d.id is string && d.ts is number && d.hash is string && d.hash.size() == 64 && d.prevHash is string
        && d.route in ['LOCAL', 'CLOUD', 'CLOUD_REDACTED', 'BLOCKED']
        && d.taskType is string && d.lengthBucket in ['S', 'M', 'L']
        && d.why is string && d.why.size() <= 600
        && d.guard.keys().hasOnly(['sensitive', 'sensitivity', 'entities'])
        && d.payloadBytes is int && d.bytesOut is int && d.latencyMs is number;
    }
    match /users/{userId}/receipts/{id} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidReceipt() && request.resource.data.id == id;
      allow delete: if isOwner(userId);
    }

    // Probe measurements: metrics only, keyed by synthetic task id, create-only.
    function isValidRun() {
      let d = request.resource.data;
      return d.keys().hasOnly(['runId', 'taskId', 'taskType', 'lengthBucket', 'backend', 'servedBy', 'ok', 'quality',
          'passed', 'ttftMs', 'totalMs', 'outTokensEst', 'inTokensEst', 'error', 'ts', 'chromeMajor'])
        && d.backend in ['on_device', 'in_cloud'] && d.ok is bool && d.passed is bool
        && d.quality is number && d.quality >= 0 && d.quality <= 1
        && d.taskId is string && d.taskId.size() <= 64;
    }
    match /users/{userId}/runs/{id} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidRun();
      allow delete: if isOwner(userId);
    }

    // Hybrid Atlas: anonymous coarse buckets. Doc id = SHA-256(uid) so one contribution per user
    // without storing the uid. Public reads are intended (aggregate dataset); no updates.
    function band(v, allowed) { return v is string && v in allowed; }
    function isValidContrib() {
      let d = request.resource.data;
      let pass = ['lt50', '50to80', 'gte80', 'na'];
      return d.keys().hasOnly(['chromeMajorBucket', 'osFamily', 'availability', 'ttftBand', 'tokensPerSecBand', 'localPassBands', 'ts'])
        && d.chromeMajorBucket is string && d.chromeMajorBucket.matches('^([0-9]{2,3}-[0-9]{2,3}|unknown)$')
        && band(d.osFamily, ['windows', 'mac', 'linux', 'chromeos', 'other'])
        && band(d.availability, ['available', 'downloadable', 'downloading', 'unavailable', 'unsupported'])
        && band(d.ttftBand, ['lt500', '500to1500', '1500to4000', 'gte4000', 'na'])
        && band(d.tokensPerSecBand, ['lt5', '5to15', '15to40', 'gte40', 'na'])
        && d.localPassBands.keys().hasOnly(['classify', 'extract', 'rewrite', 'summarize', 'translate', 'qa'])
        && band(d.localPassBands.classify, pass) && band(d.localPassBands.extract, pass)
        && band(d.localPassBands.rewrite, pass) && band(d.localPassBands.summarize, pass)
        && band(d.localPassBands.translate, pass) && band(d.localPassBands.qa, pass)
        && d.ts is int;
    }
    function ownsContrib(hid) {
      return request.auth != null && hid == hashing.sha256(request.auth.uid).toHexString().lower();
    }
    match /contrib/{hid} {
      allow get, list: if true;
      allow create: if ownsContrib(hid) && isValidContrib();
      allow update: if false;
      allow delete: if ownsContrib(hid);
    }

    // Strict default deny for all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
